---
type Props = {
  name: string;
  subskills?: string[];
  description?: string;
};

const { name, subskills, description } = Astro.props;
---

<div>
  <h3>{name}</h3>
  {
    subskills && (
      <ul>
        {subskills.map((subskill) => (
          <li>{subskill}</li>
        ))}
      </ul>
    )
  }
  {description && <p>{description}</p>}
</div>

<style>
  h3 {
    margin: 0;
    font-weight: 600;
    font-size: 1.1em;
    line-height: 1.3;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 3mm;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0.4mm;
    top: 0.72em;
    width: 1.1mm;
    height: 0;
    border-top: 0.75pt solid var(--ink);
  }

  p {
    color: var(--note);
  }
</style>
