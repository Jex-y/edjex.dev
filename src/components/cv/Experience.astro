---
type Props = {
  title: string;
  date?: string;
  subtitle?: string;
};

const { title, date, subtitle } = Astro.props;
---

<div class="entry">
  <div class="head">
    <h3>{title}</h3>
    {date && <span class="date">{date}</span>}
  </div>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  <slot />
</div>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 3mm;
  }

  h3 {
    margin: 0;
    font-weight: 600;
    font-size: 1.1em;
    line-height: 1.3;
  }

  .date {
    flex: none;
    font-size: 0.94em;
    font-variant-numeric: tabular-nums;
    color: var(--note);
  }

  .subtitle {
    margin-bottom: 0.6mm;
    font-style: italic;
    color: var(--note);
  }
  .entry :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry :global(li) {
    position: relative;
    padding-left: 3mm;
  }

  .entry :global(li)::before {
    content: '';
    position: absolute;
    left: 0.4mm;
    top: 0.72em;
    width: 1.1mm;
    height: 0;
    border-top: 0.75pt solid var(--ink);
  }
</style>
