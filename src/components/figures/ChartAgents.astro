---
type Finding = 'present' | 'construction' | 'absent' | 'unclaimed';
type Highlight = 'blue' | 'violet';
type Segment = { w: number; hl?: Highlight };
type Status = 'done' | 'running';

const FINDING: Record<Finding, { label: string; fill: string; ink: string }> = {
  present: { label: 'PRESENT', fill: '#f1c9c4', ink: '#8e2f27' },
  construction: { label: 'CONSTRUCTION', fill: '#f4e2a6', ink: '#7a5a12' },
  absent: { label: 'ABSENT', fill: '#cfe3d5', ink: '#2f5e3f' },
  unclaimed: { label: '', fill: '#f1f1ef', ink: '#a7a7a7' },
};
const RISK = {
  high: { label: 'High', fill: '#b5473f', ink: '#ffffff' },
  medium: { label: 'Medium', fill: '#e2bc4f', ink: '#3d2c06' },
  low: { label: 'Low', fill: '#4f7d5c', ink: '#ffffff' },
};
const HIGHLIGHT: Record<Highlight, string> = {
  blue: '#c9dcf4',
  violet: '#ddd0f2',
};

const COLUMNS = [
  { label: 'Claim', x: 0, w: 170 },
  { label: 'Housing', x: 170, w: 110 },
  { label: 'X-ray marker', x: 280, w: 110 },
  { label: 'Drawings', x: 390, w: 120 },
  { label: 'Risk', x: 510, w: 90 },
];
const WIDTH = 600;
const TOP = 128;
const HEAD_H = 24;
const ROW_H = 50;
const rowY = (i: number) => TOP + HEAD_H + i * ROW_H;

const ROWS: {
  claim: string;
  text: Segment[][];
  housing: Finding;
  marker: Finding;
  drawing: 'figure' | 'none';
  risk: keyof typeof RISK | 'running';
}[] = [
  {
    claim: 'Claim 1',
    text: [
      [{ w: 24 }, { w: 52, hl: 'blue' }, { w: 30 }],
      [{ w: 40 }, { w: 64, hl: 'violet' }],
    ],
    housing: 'present',
    marker: 'present',
    drawing: 'figure',
    risk: 'high',
  },
  {
    claim: 'Claim 7',
    text: [
      [{ w: 36 }, { w: 46, hl: 'blue' }],
      [{ w: 58, hl: 'violet' }, { w: 44 }],
    ],
    housing: 'present',
    marker: 'construction',
    drawing: 'figure',
    risk: 'medium',
  },
  {
    claim: 'Claim 12',
    text: [[{ w: 30 }, { w: 50, hl: 'blue' }, { w: 26 }], [{ w: 70 }]],
    housing: 'construction',
    marker: 'unclaimed',
    drawing: 'none',
    risk: 'medium',
  },
  {
    claim: 'Claim 19',
    text: [
      [{ w: 44 }, { w: 40, hl: 'violet' }],
      [{ w: 34 }, { w: 48 }],
    ],
    housing: 'absent',
    marker: 'absent',
    drawing: 'none',
    risk: 'running',
  },
];
const CHART_BOTTOM = rowY(ROWS.length);

const segments = (line: Segment[], x0: number, y: number) =>
  line.reduce<{ x: number; w: number; y: number; hl?: Highlight }[]>(
    (acc, seg) => {
      const prev = acc.at(-1);
      const x = prev ? prev.x + prev.w + 4 : x0;
      return [...acc, { x, w: seg.w, y, hl: seg.hl }];
    },
    [],
  );

const AGENT = { x: 330, y: 60 };
const SUBAGENT_Y = 110;
const SUBAGENTS: { column: number; status: Status }[] = [
  { column: 1, status: 'done' },
  { column: 2, status: 'done' },
  { column: 3, status: 'done' },
  { column: 4, status: 'running' },
];
const subagentX = (column: number) => COLUMNS[column].x + COLUMNS[column].w / 2;

const LEGEND: { finding: Finding; label: string; x: number }[] = [
  { finding: 'present', label: 'Present', x: 0 },
  { finding: 'construction', label: 'Depends on claim construction', x: 70 },
  { finding: 'absent', label: 'Absent', x: 240 },
  { finding: 'unclaimed', label: 'Not claimed', x: 304 },
];
---

<figure>
  <svg
    viewBox={`0 0 ${WIDTH} ${CHART_BOTTOM + 28}`}
    width="100%"
    role="img"
    aria-label="Schematic of a freedom-to-operate chart. The customer's documents, internal data sources and web search feed one chart agent, which hands each column to a subagent. Rows are patent claims; feature cells are coloured present, depends on claim construction, absent or not claimed; phrases in each claim are highlighted in the same colour as the matching evidence; a drawings column holds patent figures; the last column is the risk."
  >
    <defs>
      <marker
        id="chart-arrow"
        viewBox="0 0 6 6"
        refX="5"
        refY="3"
        markerWidth="6"
        markerHeight="6"
        orient="auto"
      >
        <path d="M 0 0 L 6 3 L 0 6 z" fill="#000000"></path>
      </marker>
    </defs>

    <g fill="#ffffff" stroke="#000000" stroke-width="0.8">
      <path d="M 12 4 h 18 l 6 6 v 24 h -24 z"></path>
      <path d="M 8 8 h 18 l 6 6 v 24 h -24 z"></path>
      <path d="M 4 12 h 18 l 6 6 v 24 h -24 z"></path>
    </g>
    <g fill="#a7a7a7">
      <rect x="8" y="24" width="14" height="1.6"></rect>
      <rect x="8" y="29" width="16" height="1.6"></rect>
      <rect x="8" y="34" width="10" height="1.6"></rect>
    </g>
    <text x="46" y="28" font-size="11" font-style="italic" fill="#5f5f5f"
      >the customer's documents</text
    >

    <g fill="#ffffff" stroke="#000000" stroke-width="0.8">
      <path d="M 4 58 v 20 a 15 4.5 0 0 0 30 0 v -20"></path>
      <ellipse cx="19" cy="58" rx="15" ry="4.5"></ellipse>
      <path d="M 4 68 a 15 4.5 0 0 0 30 0" fill="none"></path>
    </g>
    <text x="46" y="72" font-size="11" font-style="italic" fill="#5f5f5f"
      >internal data sources</text
    >

    <g fill="#ffffff" stroke="#000000" stroke-width="0.8">
      <circle cx="19" cy="104" r="14"></circle>

      <ellipse cx="19" cy="104" rx="6" ry="14" fill="none"></ellipse>

      <path d="M 5 104 H 33 M 8 97 H 30 M 8 111 H 30" fill="none"></path>
    </g>

    <text x="46" y="108" font-size="11" font-style="italic" fill="#5f5f5f"
      >web search</text
    >

    <g stroke="#000000" stroke-width="0.9" fill="none">
      <path d="M 186 24 C 250 24, 270 58, 318 59" marker-end="url(#chart-arrow)"
      ></path>
      <path d="M 182 68 C 250 68, 280 61, 318 61" marker-end="url(#chart-arrow)"
      ></path>
      <path
        d="M 120 104 C 230 104, 270 64, 318 62"
        marker-end="url(#chart-arrow)"></path>
      {
        SUBAGENTS.map(({ column }) => (
          <>
            <line
              x1={AGENT.x}
              y1={AGENT.y}
              x2={subagentX(column)}
              y2={SUBAGENT_Y}
            />
            <line
              x1={subagentX(column)}
              y1={SUBAGENT_Y}
              x2={subagentX(column)}
              y2={TOP}
              stroke-dasharray="2 2"
            />
          </>
        ))
      }
    </g>
    {
      SUBAGENTS.map(({ column, status }) => (
        <circle
          cx={subagentX(column)}
          cy={SUBAGENT_Y}
          r="4"
          fill={status === 'done' ? '#000000' : '#a7a7a7'}
          stroke="#000000"
          stroke-width="0.9"
        />
      ))
    }
    <circle cx={AGENT.x} cy={AGENT.y} r="7" fill="#000000"></circle>
    <text
      x={AGENT.x + 13}
      y={AGENT.y - 6}
      font-size="11"
      font-style="italic"
      fill="#5f5f5f">chart agent</text
    >
    <text
      x={subagentX(1) - 10}
      y={SUBAGENT_Y + 4}
      font-size="11"
      font-style="italic"
      fill="#5f5f5f"
      text-anchor="end">subagents</text
    >

    <rect
      x="0.5"
      y={TOP}
      width={WIDTH - 1}
      height={CHART_BOTTOM - TOP}
      fill="#ffffff"
      stroke="#000000"
      stroke-width="0.9"></rect>
    {
      COLUMNS.map(({ label, x }, j) => (
        <>
          {j > 0 && (
            <line
              x1={x}
              y1={TOP}
              x2={x}
              y2={CHART_BOTTOM}
              stroke="#cdcdcd"
              stroke-width="0.7"
            />
          )}
          <text
            x={x + 7}
            y={TOP + 16}
            font-size="10.5"
            font-weight="600"
            fill="#000000"
          >
            {label}
          </text>
        </>
      ))
    }
    <line
      x1="0.5"
      y1={TOP + HEAD_H}
      x2={WIDTH - 0.5}
      y2={TOP + HEAD_H}
      stroke="#000000"
      stroke-width="0.9"></line>

    {
      ROWS.map((row, i) => {
        const y = rowY(i);
        const cell = (column: number, finding: Finding, hl: Highlight) => {
          const { x, w } = COLUMNS[column];
          const f = FINDING[finding];
          return finding === 'unclaimed' ? (
            <>
              <rect
                x={x + 3}
                y={y + 3}
                width={w - 6}
                height={ROW_H - 6}
                fill={f.fill}
              />
              <rect
                x={x + w / 2 - 6}
                y={y + ROW_H / 2}
                width="12"
                height="1.2"
                fill={f.ink}
              />
            </>
          ) : (
            <>
              <rect
                x={x + 3}
                y={y + 3}
                width={w - 6}
                height={ROW_H - 6}
                fill={f.fill}
              />
              <text
                x={x + 8}
                y={y + 14}
                font-size="7"
                letter-spacing="0.4"
                fill={f.ink}
              >
                {f.label}
              </text>
              {finding !== 'absent' && (
                <rect
                  x={x + 7}
                  y={y + 20}
                  width="44"
                  height="8"
                  fill={HIGHLIGHT[hl]}
                />
              )}
              <rect x={x + 9} y={y + 23} width="40" height="2" fill="#5f5f5f" />
              <rect
                x={x + 9}
                y={y + 33}
                width={w - 30}
                height="2"
                fill="#5f5f5f"
                opacity="0.6"
              />
            </>
          );
        };
        const drawings = COLUMNS[3];
        const risk = COLUMNS[4];
        return (
          <>
            {i > 0 && (
              <line
                x1="0.5"
                y1={y}
                x2={WIDTH - 0.5}
                y2={y}
                stroke="#cdcdcd"
                stroke-width="0.7"
              />
            )}
            <text
              x="7"
              y={y + 14}
              font-size="10"
              font-weight="600"
              fill="#000000"
            >
              {row.claim}
            </text>
            {row.text.map((line, k) =>
              segments(line, 7, y + 24 + k * 10).map((seg) => (
                <>
                  {seg.hl && (
                    <rect
                      x={seg.x - 2}
                      y={seg.y - 3}
                      width={seg.w + 4}
                      height="8"
                      fill={HIGHLIGHT[seg.hl]}
                    />
                  )}
                  <rect
                    x={seg.x}
                    y={seg.y}
                    width={seg.w}
                    height="2"
                    fill="#5f5f5f"
                  />
                </>
              )),
            )}

            {cell(1, row.housing, 'blue')}
            {cell(2, row.marker, 'violet')}

            {row.drawing === 'figure' ? (
              <g transform={`translate(${drawings.x + 10} ${y + 6})`}>
                <rect
                  width="58"
                  height="38"
                  fill="#ffffff"
                  stroke="#000000"
                  stroke-width="0.6"
                />
                <path
                  d="M 10 30 L 16 12 H 34 L 40 30 Z"
                  fill="none"
                  stroke="#000000"
                  stroke-width="0.7"
                />
                <ellipse
                  cx="25"
                  cy="12"
                  rx="9"
                  ry="3"
                  fill="none"
                  stroke="#000000"
                  stroke-width="0.7"
                />
                <rect
                  x="20"
                  y="21"
                  width="10"
                  height="5"
                  fill={HIGHLIGHT.violet}
                  stroke="#7a5fb0"
                  stroke-width="0.6"
                />
                <line
                  x1="40"
                  y1="12"
                  x2="50"
                  y2="7"
                  stroke="#000000"
                  stroke-width="0.5"
                />
                <text x="50" y="6" font-size="6" fill="#000000">
                  12
                </text>
                <line
                  x1="30"
                  y1="24"
                  x2="50"
                  y2="28"
                  stroke="#000000"
                  stroke-width="0.5"
                />
                <text x="50" y="34" font-size="6" fill="#000000">
                  14
                </text>
                <text
                  x="64"
                  y="20"
                  font-size="7"
                  font-style="italic"
                  fill="#5f5f5f"
                >
                  Fig. {i + 2}
                </text>
              </g>
            ) : (
              <rect
                x={drawings.x + drawings.w / 2 - 6}
                y={y + ROW_H / 2}
                width="12"
                height="1.2"
                fill="#a7a7a7"
              />
            )}

            {row.risk === 'running' ? (
              <>
                <rect
                  x={risk.x + 3}
                  y={y + 3}
                  width={risk.w - 6}
                  height="20"
                  fill="#e6e6e6"
                />
                <rect
                  x={risk.x + 7}
                  y={y + 29}
                  width="50"
                  height="2"
                  fill="#e6e6e6"
                />
              </>
            ) : (
              <>
                <rect
                  x={risk.x + 3}
                  y={y + 3}
                  width={risk.w - 6}
                  height={ROW_H - 6}
                  fill={RISK[row.risk].fill}
                />
                <text
                  x={risk.x + 9}
                  y={y + 21}
                  font-size="11"
                  font-weight="600"
                  fill={RISK[row.risk].ink}
                >
                  {RISK[row.risk].label}
                </text>
                <rect
                  x={risk.x + 9}
                  y={y + 30}
                  width="44"
                  height="1.8"
                  fill={RISK[row.risk].ink}
                  opacity="0.7"
                />
              </>
            )}
          </>
        );
      })
    }

    {
      LEGEND.map(({ finding, label, x }) => (
        <>
          <rect
            x={x}
            y={CHART_BOTTOM + 13}
            width="9"
            height="9"
            fill={FINDING[finding].fill}
          />
          <text x={x + 13} y={CHART_BOTTOM + 21} font-size="10" fill="#5f5f5f">
            {label}
          </text>
        </>
      ))
    }
  </svg>
  <figcaption>
    A freedom-to-operate chart. The customer's own documents, internal data
    sources and web search feed one chart agent, which hands each column to a
    subagent. Cells are coloured by finding, and each phrase in a claim is
    highlighted in the same colour as its evidence, figures included. Schematic.
  </figcaption>
</figure>
