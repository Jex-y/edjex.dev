---
const DECADES = [1, 10, 100, 1000, 10000];
const OURS = 2.2;
const YOLO = 1449;

const x = (microjoules: number) => 10 + (Math.log10(microjoules) / 4) * 250;
const label = (value: number) =>
  value >= 1000 ? `${value / 1000}k` : String(value);
---

<figure>
  <svg
    viewBox="0 0 270 72"
    width="100%"
    role="img"
    aria-label="Energy per frame on a log scale: the three-layer network at 2.2 microjoules against YOLO11-nano at 1,449"
  >
    <line x1="10" y1="40" x2="260" y2="40" stroke="#000000" stroke-width="0.8"
    ></line>
    {
      DECADES.map((decade) => (
        <>
          <line
            x1={x(decade)}
            y1="37"
            x2={x(decade)}
            y2="43"
            stroke="#000000"
            stroke-width="0.8"
          />
          <text
            x={x(decade)}
            y="58"
            text-anchor="middle"
            font-size="10"
            fill="#5f5f5f"
          >
            {label(decade)}
          </text>
        </>
      ))
    }
    <circle cx={x(OURS)} cy="40" r="4.2" fill="#000000"></circle>
    <circle
      cx={x(YOLO)}
      cy="40"
      r="4.2"
      fill="#ffffff"
      stroke="#000000"
      stroke-width="1.1"></circle>
    <text x="24" y="26" font-size="11" fill="#000000">three layers, 2.2</text>
    <text x="262" y="26" text-anchor="end" font-size="11" fill="#000000"
      >YOLO11-nano, 1,449</text
    >
  </svg>
  <figcaption><slot /></figcaption>
</figure>
