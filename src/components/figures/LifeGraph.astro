---
type Anchor = 'start' | 'middle' | 'end';
type Node = {
  label: string;
  x: number;
  y: number;
  anchor: Anchor;
  dx: number;
  dy: number;
};

const NODES: Node[] = [
  { label: 'Durham', x: 28, y: 112, anchor: 'middle', dx: 0, dy: 20 },
  { label: 'rowing', x: 92, y: 40, anchor: 'middle', dx: 0, dy: -10 },
  { label: 'club', x: 182, y: 20, anchor: 'start', dx: 8, dy: 4 },
  { label: 'forecast', x: 232, y: 92, anchor: 'middle', dx: 0, dy: -11 },
  { label: 'CS', x: 120, y: 122, anchor: 'start', dx: 8, dy: -8 },
  { label: 'TD-MPC2', x: 56, y: 198, anchor: 'middle', dx: 0, dy: 20 },
  { label: 'thesis', x: 150, y: 196, anchor: 'middle', dx: 0, dy: 20 },
  { label: 'Solve', x: 228, y: 170, anchor: 'start', dx: 8, dy: 4 },
  { label: 'agents', x: 244, y: 222, anchor: 'end', dx: -8, dy: 4 },
];
const EDGES = [
  [0, 1],
  [1, 2],
  [1, 3],
  [0, 4],
  [4, 3],
  [4, 5],
  [4, 6],
  [6, 7],
  [7, 8],
];
const CURRENT = 'Solve';
---

<figure>
  <svg
    viewBox="0 0 270 240"
    width="100%"
    role="img"
    aria-label="A small graph of how the things on this page connect, from Durham and rowing to Solve and agents"
  >
    <g stroke="#000000" stroke-width="0.9">
      {
        EDGES.map(([from, to]) => (
          <line
            x1={NODES[from].x}
            y1={NODES[from].y}
            x2={NODES[to].x}
            y2={NODES[to].y}
          />
        ))
      }
    </g>
    {
      NODES.map((node) => (
        <>
          <circle
            cx={node.x}
            cy={node.y}
            r="3.6"
            fill={node.label === CURRENT ? '#000000' : '#ffffff'}
            stroke="#000000"
            stroke-width="1"
          />
          <text
            x={node.x + node.dx}
            y={node.y + node.dy}
            text-anchor={node.anchor}
            font-size="11.5"
            fill="#000000"
          >
            {node.label}
          </text>
        </>
      ))
    }
  </svg>
  <figcaption>How the things on this page lead into one another.</figcaption>
</figure>
