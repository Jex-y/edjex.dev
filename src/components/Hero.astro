---
import { EMAIL } from '../consts';
---

<div class="hero">
  <canvas
    id="hero-surface"
    role="img"
    aria-label="A ridgeline heatmap of water fleas: rows of fine lines rising into a peak wherever one is, two of them circling"
  ></canvas>
  <canvas id="hero-labels" aria-hidden="true"></canvas>
  <div class="overlay">
    <header>
      <h1>Ed Jex</h1>
      <nav>
        <a href="#work">Work</a>
        <a href="#writing">Writing</a>
        <a href="#cv">CV</a>
        <a href={`mailto:${EMAIL}`}>Email</a>
      </nav>
    </header>
    <p class="caption">
      What my thesis detector sees: a heatmap with one peak per water flea. The
      two going in circles are stressed. Point at the surface to add one.
      Simulated.
    </p>
  </div>
</div>

<script>
  import { ridgeline } from '../scripts/ridgeline';

  const surface = document.getElementById('hero-surface');
  const labels = document.getElementById('hero-labels');
  if (
    surface instanceof HTMLCanvasElement &&
    labels instanceof HTMLCanvasElement
  ) {
    ridgeline(surface, labels);
  }
</script>

<style>
  .hero {
    position: relative;
    height: 440px;
  }

  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  #hero-labels {
    pointer-events: none;
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 36px 22px 0;
    pointer-events: none;
  }

  header {
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    margin: 0;
    font-weight: 300;
    font-size: 52px;
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: 15px;
    pointer-events: auto;
  }

  nav a {
    padding: 8px 0;
  }

  .caption {
    display: none;
  }

  @media (min-width: 1180px) {
    .hero {
      height: 620px;
    }

    .overlay {
      grid-template-columns: minmax(0, 1fr) minmax(0, 600px) minmax(0, 1fr);
      padding: 64px 40px 28px;
    }

    header {
      grid-column: 2;
      grid-row: 1;
    }

    h1 {
      font-size: 84px;
    }

    .caption {
      grid-column: 3;
      grid-row: 1;
      display: block;
      align-self: end;
      max-width: 290px;
      padding: 4px 0 0 40px;
      font-size: 12.5px;
      font-style: italic;
      line-height: 1.45;
      color: var(--note);
    }
  }
</style>
